{
  "info": {
    "name": "RepairApp Authentication API",
    "description": "Complete authentication APIs including dual login methods (mobile+password and mobile+OTP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Login Methods",
      "description": "Two ways to login: mobile+password or mobile+OTP",
      "item": [
        {
          "name": "Login with Mobile & Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"password123\",\n  \"rememberMe\": false\n}"
            }
          },
          "response": []
        },
        {
          "name": "Step 1: Send OTP for Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/send-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", "send-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Step 2: Verify OTP and Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otpCode\": \"666666\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Resend Login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", "resend-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Registration (3-Step Process)",
      "description": "Three-step signup: mobile, OTP verification, complete registration",
      "item": [
        {
          "name": "Step 1: Initiate Signup with Mobile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup/mobile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup", "mobile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"8765432109\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Step 2: Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup", "verify-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"8765432109\",\n  \"otpCode\": \"666666\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Step 3: Complete Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup", "complete"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"8765432109\",\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Resend Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup", "resend-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"8765432109\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Password Management",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otpCode\": \"666666\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Token Management",
      "item": [
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh?refreshToken={{refresh_token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"],
              "query": [
                {
                  "key": "refreshToken",
                  "value": "{{refresh_token}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Utility",
      "item": [
        {
          "name": "Check Email Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/check-email?email=test@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "check-email"],
              "query": [
                {
                  "key": "email",
                  "value": "test@example.com"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "description": "Base URL of the RepairApp API"
    },
    {
      "key": "access_token",
      "value": "",
      "description": "JWT access token received after login"
    },
    {
      "key": "refresh_token",
      "value": "",
      "description": "JWT refresh token received after login"
    }
  ]
}
